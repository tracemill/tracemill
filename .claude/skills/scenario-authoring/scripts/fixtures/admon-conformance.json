{
  "format_cases": [
    {
      "name": "split 24-hour timestamp preamble",
      "input": "02/01/2010\n05:09:11.485\ndcName=dc1\nNames:\n\tname=Alice\n",
      "key": "name",
      "extract_format": "admon",
      "fidelity_format": "admon"
    },
    {
      "name": "generic kv before later dcName",
      "input": "EventCode=4624 user=alice\ndcName=dc1\n",
      "key": "EventCode",
      "extract_format": "kv",
      "fidelity_format": "kv"
    },
    {
      "name": "bare dcName generic kv",
      "input": "dcName=dc1\nEventCode=4624\n",
      "key": "dcName",
      "extract_format": "kv",
      "fidelity_format": "kv"
    },
    {
      "name": "repeated bare dcName stays generic kv",
      "input": "dcName=dc1\ndcName=dc2\nEventCode=4624 user=alice\n",
      "key": "EventCode",
      "extract_format": "kv",
      "fidelity_format": "kv"
    },
    {
      "name": "admon after whitespace and repeated BOM",
      "input": "\n\uFEFF\uFEFFdcName=dc1\nNames:\n\tname=Alice\n",
      "key": "name",
      "extract_format": "admon",
      "fidelity_format": "admon"
    },
    {
      "name": "xml after long whitespace preamble",
      "leading_spaces": 300,
      "input": "<Event xmlns=\"http://schemas.microsoft.com/win/2004/08/events/event\"><System><EventID>1</EventID></System></Event>\n",
      "key": "System/EventID",
      "extract_format": "xml",
      "fidelity_format": "xml"
    }
  ],
  "first_record_cases": [
    {
      "name": "malformed trailing record is ignored",
      "input": "dcName=dc1\nNames:\n\tname=Alice\ndcName=dc2\nnot valid\n",
      "generated": "dcName=dc1\nNames:\n\tname=Alice\n",
      "load_bearing": "name",
      "master_field_count": 2
    },
    {
      "name": "formatter-compatible underscored field name",
      "input": "dcName=dc1\nNames:\n\tobject_class=groupPolicyContainer\n",
      "generated": "dcName=dc1\nNames:\n\tobject_class=groupPolicyContainer\n",
      "load_bearing": "object_class",
      "master_field_count": 2
    },
    {
      "name": "indented wrapped continuation is ignored",
      "input": "dcName=dc1\nNames:\n\tdescription=first line\n\twrapped second line\n\tname=Alice\n",
      "generated": "dcName=dc1\nNames:\n\tdescription=first line\n\tname=Alice\n",
      "load_bearing": "description,name",
      "master_field_count": 3
    },
    {
      "name": "field-shaped wrapped DN continuation is folded",
      "input": "dcName=dc1\nNames:\n\tdistinguishedName=CN={06F1},CN=Policies,\n\t DC=corp,DC=local\n\tname=Alice\n",
      "generated": "dcName=dc1\nNames:\n\tdistinguishedName=CN={06F1},CN=Policies,DC=corp,DC=local\n\tname=Alice\n",
      "load_bearing": "distinguishedName,name",
      "master_field_count": 3
    },
    {
      "name": "tab-space continuation containing equals is folded",
      "input": "dcName=dc1\nNames:\n\tdescription=a b\n\t  {G}={H}\n\tname=Alice\n",
      "generated": "dcName=dc1\nNames:\n\tdescription=a b {G}={H}\n\tname=Alice\n",
      "load_bearing": "description,name",
      "master_field_count": 3
    }
  ],
  "extraction_cases": [
    {
      "name": "wrapped continuation record remains extractable",
      "input": "dcName=dc1\nNames:\n\tdescription=first line\n\twrapped second line\n\tname=Alice\n",
      "key": "name",
      "value": "Alice",
      "total": 1
    },
    {
      "name": "repeated values use jq-compatible JSON encoding",
      "input": "dcName=dc1\nNames:\n\tdescription=A & B <x>\n\tdescription=line\u2028separator\n\tdescription=para\u2029separator\n",
      "key": "description",
      "value": "[\"A & B <x>\",\"line\u2028separator\",\"para\u2029separator\"]",
      "total": 1
    },
    {
      "name": "field-shaped wrapped DN value is folded",
      "input": "dcName=dc1\nNames:\n\tdistinguishedName=CN={06F1},CN=Policies,\n\t DC=corp,DC=local\n",
      "key": "distinguishedName",
      "value": "CN={06F1},CN=Policies,DC=corp,DC=local",
      "total": 1
    },
    {
      "name": "tab-space continuation with equals remains extractable",
      "input": "dcName=dc1\nNames:\n\tdescription=a b\n\t  {G}={H}\n\tname=Alice\n",
      "key": "description",
      "value": "a b {G}={H}",
      "total": 1
    }
  ],
  "invalid_record_cases": [
    {
      "name": "field name with spaces",
      "input": "dcName=dc1\nNames:\n\tname=Alice\n\tobject class=groupPolicyContainer\n",
      "contains": "unrecognized line"
    },
    {
      "name": "section name containing equals",
      "input": "dcName=dc1\nObject Details (v=2):\n\tname=Alice\n",
      "contains": "unrecognized line"
    }
  ],
  "load_bearing_cases": [
    {
      "name": "distinguished name commas",
      "input": "dcName=dc1\nNames:\n\tobjectCategory=CN=Group-Policy-Container,CN=Schema,CN=Configuration,DC=corp,DC=local\n",
      "token": "objectCategory~CN=Group-Policy-Container\\,CN=Schema\\,*",
      "globs": [
        "CN=Group-Policy-Container,CN=Schema,*"
      ]
    },
    {
      "name": "UNC path backslashes",
      "input": "dcName=dc1\nAdditional Details:\n\tServiceFileName=\\\\fileserver\\share\\tool.exe\n",
      "token": "ServiceFileName~\\\\fileserver\\share\\*",
      "globs": [
        "\\\\fileserver\\share\\*"
      ]
    },
    {
      "name": "literal multivalue pipes",
      "input": "dcName=dc1\nObject Details:\n\tobjectClass=top|container|groupPolicyContainer\n",
      "token": "objectClass~top\\|container\\|groupPolicyContainer",
      "globs": [
        "top|container|groupPolicyContainer"
      ]
    },
    {
      "name": "paired backslashes before alternation",
      "input": "dcName=dc1\nAdditional Details:\n\tpath=backup\n",
      "token": "path~C:\\\\|backup",
      "globs": [
        "C:\\\\",
        "backup"
      ]
    }
  ],
  "diagnostic_cases": [
    {
      "name": "generic kv versus xml",
      "master": "EventCode=4624 user=alice\n",
      "generated": "<Event><System><EventID>1</EventID></System></Event>\n",
      "contains": "differ",
      "excludes": "generic key=value"
    }
  ]
}
